# Identical to commands.gbnf except rule names use hyphens for llama.cpp.
root ::= (instruction)+
instruction ::= verb " " target ( " " argument-list )? "\n"
verb ::= "FIX" | "OPEN" | "SET" | "TEST" | "RUN" | "READ" | "WRITE" | "ALLOC" | "FREE"
target ::= identifier | filepath | hex-address
argument-list ::= argument ( " " argument )? ( " " argument )?
argument ::= flag | identifier | integer | hex-address
identifier  ::= [a-zA-Z_] [a-zA-Z0-9_-]*
filepath    ::= "/" [a-zA-Z0-9_-]+ ( "/" [a-zA-Z0-9_-]+ )* ("." [a-zA-Z0-9]+)?
flag        ::= "--" [a-zA-Z0-9_-]+
integer     ::= "-"? [0-9]+
hex-address ::= "0x" [0-9a-fA-F]+
